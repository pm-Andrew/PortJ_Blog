---
import BaseLayout from "./BaseLayout.astro";
import { Image } from "astro:assets";

// Extract frontmatter safely from Astro.props. Use optional chaining so
// missing frontmatter doesn't crash the prerender step on Netlify.
const { frontmatter } = Astro.props;

// Convert publication date to a Date object (or null) for safe formatting.
const pubDate = frontmatter?.pubDate ? new Date(frontmatter.pubDate) : null;
---

<BaseLayout pageTitle={frontmatter?.title ?? "Blog"}>
  <!-- Render Image only when present to avoid runtime errors -->
  {
    frontmatter?.image?.src ? (
      <Image
        class="card-image"
        src={frontmatter.image.src}
        width={200}
        height={120}
        alt={frontmatter.image.alt ?? frontmatter.title ?? ""}
      />
    ) : (
      "Image Broken or Missing"
    )
  }

  <div
    class="m-2 p-2 rounded-lg border-2 border-(--border) shadow-[0_2px_8px_rgba(13,13,13,0.05)]"
  >
    <!-- Show formatted date if available -->
    <p>{pubDate ? pubDate.toLocaleDateString() : ""}</p>

    <!-- Optional description and author -->
    {
      frontmatter?.description ? (
        <p>
          <em>{frontmatter.description}</em>
        </p>
      ) : null
    }
    {
      frontmatter?.author ? (
        <p class="text-(--void)">Written by: {frontmatter.author}</p>
      ) : (
        "Broken or Missing"
      )
    }
  </div>

  <!-- Tags: render only when an array with items exists -->
  {
    Array.isArray(frontmatter?.tags) && frontmatter.tags.length ? (
      <div class="m-2 p-2 rounded-lg border-2 border-(--border) shadow-[0_2px_8px_rgba(13,13,13,0.05)]">
        {frontmatter.tags.map((tag: string) => (
          <p class="text-2xl text-(--primary)">
            <a href={`/tags/${tag}`}>{tag}</a>
          </p>
        ))}
      </div>
    ) : (
      "No tags available"
    )
  }

  <slot />
</BaseLayout>
