---
import { Image as AstroImage } from "astro:assets";
import { getCollection } from "astro:content";
//
import FormattedDate from "./FormattedDate.astro";
// using a astro.props grab title and url from posts and create links in a
// Collection in /blog.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Destructure props for clarity and easier access
const { title, url, pubDate, description } = Astro.props;

// This is what is shown on the blog page. It is a list of all the posts in the blog collection.
// Each post is a link to the post page. The post page is generated from the markdown file in the blog collection.
---

<section>
  <ul>
    {
      posts.map((post) => (
        <li class="bg-(--card) border-2 border-(--border) p-4 m-4 rounded-lg shadow-[0_2px_8px_rgba(13,13,13,0.05)]">
          <a href={`/posts/${post.id}/`}>
            {post.data.image && (
              <AstroImage
                width={400}
                height={350}
                src={post.data.image.src}
                alt={post.data.image.alt ?? ""}
              />
            )}
            <div class="flex items-center justify-between">
              <h2 class="text-2xl m-2 my-3">{post.data.title}</h2>
              <p class="text-sm text-(--secondary)" />
              <FormattedDate date={post.data.pubDate} />
            </div>
            <p class="description">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Blog Themes */

  .blogCard {
    margin: 2px;
    padding: 3px;
    display: flex;
  }

  .blogCard h4,
  .blogCard p {
    margin-left: 3em;
    padding: 1em;
    align-content: center;
    justify-content: baseline;
  }
  .blogCard img {
    height: 200px;
    width: 350px;
  }
</style>
