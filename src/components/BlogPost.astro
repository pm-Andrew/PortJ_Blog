---
import { getCollection } from "astro:content";
import BlogCard from "./BlogCard.astro";

// Fetch and sort the blog collection once for the reusable post-list view.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Each BlogCard links to the generated post page and owns the single-post preview markup.
---

<section
  class="m-8 p-2 text-(--sumi-black) font-bold font-mono rounded-2xl border-2 border-(--border) shadow-[0_2px_8px_rgba(13,13,13,0.05)]"
>
  <ul>
    {posts.map((post) => <BlogCard post={post} />)}
  </ul>
</section>
