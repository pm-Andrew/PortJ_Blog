---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
//
import FormattedDate from "./FormattedDate.astro";
// using a astro.props grab title and url from posts and create links in a
// Collection in /blog.
const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// Destructure props for clarity and easier access
const { title, url, pubDate, description, heroImage } = Astro.props;
---

<section>
  <ul>
    {
      posts.map((post) => (
        <li class="blogCard">
          <a href={`/posts/${post.id}/`}>
            {post.data.heroImage && (
              <Image
                width={400}
                height={350}
                src={post.data.heroImage}
                alt=""
              />
            )}
            <h4 class="title">{post.data.title}</h4>
            <p class="date">
              <FormattedDate date={post.data.pubDate} />
            </p>
            <p class="description">{post.data.description}</p>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* Blog Themes */

  .blogCard {
    margin: 2px;
    padding: 3px;
    display: flex;
  }

  .blogCard h4,
  .blogCard p {
    margin-left: 3em;
    padding: 1em;
    align-content: center;
    justify-content: baseline;
    /* TESTING */
    border: 2px solid var(--accent);
  }
  .blogCard img {
    height: 200px;
    width: 350px;
  }
</style>
