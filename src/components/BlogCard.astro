---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
// Simple, reusable card component that renders a single blog post preview.
// Props:
// - post: an entry from `getCollection('blog')` (Astro content entry)
type Props = {
  post: CollectionEntry<"blog">;
};

const { post } = Astro.props as Props;
const { data } = post;
---

<li class="blogCard">
  <a href={`/posts/${post.id}/`} class="card-link">
    <!-- Render hero image if provided. Use the Image component so both
         string URLs and Astro asset objects are handled. -->
    {
      data.image ? (
        <Image
          class="card-image"
          src={data.image.src}
          width={200}
          height={120}
          alt={data.image.alt}
        />
      ) : null
    }

    <div class="card-body">
      <h4 class="card-title">{data.title}</h4>
      {(<p class="card-date">{data.pubDate.toLocaleDateString()}</p>)}
      <p class="card-desc">{data.description}</p>
    </div>
  </a>
</li>

<style>
  .blogCard {
    list-style: none;
    border: 1px solid var(--sumi-black);
    padding: 1em;
    margin: 0.5em;
    width: auto;
  }
  .card-link {
    display: flex;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
    padding: 0.5rem;
  }
  .card-image {
    width: 200px;
    height: 120px;
    object-fit: cover;
    flex-shrink: 0;
    justify-content: flex-start;
  }
  .card-body {
    display: flex;
    flex-direction: column;
    justify-content: start;
  }
  .card-title {
    margin: 0 0 0.25rem 0;
    font-size: 1.05rem;
  }
  .card-date {
    margin: 0;
    font-size: 0.85rem;
    color: #666;
  }
  .card-desc {
    margin-top: 0.5rem;
    color: #333;
  }
</style>
