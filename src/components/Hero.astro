---
import Social from "./Social.astro";
---

<div
  class="m-8 p-8 text-(--mist) font-bold font-mono
  rounded-2xl border-2 border-(--border) shadow-[0_2px_8px_rgba(13,13,13,0.05)]
  bg-linear-to-r from-(--primary)/85 to-(--accent)/95 to-80% dark:bg-linear-to-r dark:from-(--primary)/85 dark:to-(--accent)/75 dark:to-90%"
>
  <h1 class="text-2xl">
    Welcome to <span class="text-(--sumi-black)"
      ><span class="text-(--mountain-navy)">Port</span>Journey!</span
    >
  </h1>
  <p>
    A place where I share my ideas and what I am working on. <br />
    I am a Web Developer and Cybersecurity Student.
  </p>
  <div class="my-2 flex gap-4">
    <Social platform="linkedin" username="in/andrewsabourin" />
    <Social platform="github" username="pm-Andrew" />
    <Social platform="youtube" username="Fireship" />
  </div>
</div>
