---
// import Navigation to Header
import Navigation from "./Navigation.astro";
// import Menu for mobile use
import Menu from "./Menu.astro";
// import icon for light/dark mode
import ThemeIcon from "./ThemeIcon.astro";
---

<header
  class="border-b-4 border-(--tengu-red) bg-(--paper-white) px-4 py-2 shadow-[0_2px_8px_rgba(13,13,13,0.05)] dark:bg-(--sumi-black)"
>
  <nav class="ml-2 flex items-center justify-start gap-4">
    <!-- Put a logo or something here -->
    <!-- <h1 class="logo">PortJourney</h1> -->
    <Navigation />
    <Menu />
    <ThemeIcon />
  </nav>
</header>
