---
// variables to link site and username
import Social from "./Social.astro";
---

<footer
  class="m-8
  p-8
  text-(--mist)
  font-bold
  font-mono
  rounded-2xl
  border-2
  border-(--border)
  shadow-[0_2px_8px_rgba(13,13,13,0.05)]
  bg-linear-to-r
  from-(--accent)
  95
  to-(--primary)
  85
  to-80%
  dark:bg-linear-to-r
  dark:from-(--primary)
  85
  dark:to-(--accent)
  75
  dark:to-90%"
>
  <Social platform="linkedin" username="in/andrewsabourin" />
  <Social platform="github" username="pm-Andrew" />
  <Social platform="youtube" username="Fireship" />
</footer>
