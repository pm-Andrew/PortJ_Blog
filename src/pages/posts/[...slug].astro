---
import { getCollection, render } from "astro:content";
import MarkdownPostLayout from "../../layouts/MarkdownPostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: Awaited<ReturnType<typeof getCollection>>[number];
};

const { post } = Astro.props as Props;
const { Content } = await render(post);

// This is where you can add additional metadata for the page, such as title, description, etc.
---

<MarkdownPostLayout frontmatter={post.data}>
  <!-- Post content -->
  <div
    class="border-2 border-(--border) p-4 m-4 rounded-lg shadow-[0_2px_8px_rgba(13,13,13,0.05)]"
  >
    <Content />
  </div>
</MarkdownPostLayout>
