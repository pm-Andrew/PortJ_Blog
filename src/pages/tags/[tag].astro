---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";

export async function getStaticPaths() {
  // Read posts through the validated content collection so tag pages stay
  // aligned with the blog and post routes.
  const posts = await getCollection("blog");

  // Generate one static page for every unique tag in the collection.
  const uniqueTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return uniqueTags.map((tag) => {
    // Pass only the posts assigned to the current tag into that page.
    const filteredPosts = posts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

type Props = {
  posts: CollectionEntry<"blog">[];
};

const { tag } = Astro.params;
const { posts } = Astro.props as Props;
---

<BaseLayout pageTitle={tag}>
  <p>Posts tagged with {tag}</p>
  <ul>
    {posts.map((post) => <BlogCard post={post} />)}
  </ul>
</BaseLayout>
