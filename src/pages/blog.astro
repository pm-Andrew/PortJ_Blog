---
// Import Collection
import { getCollection } from "astro:content";
// import global CSS
import "../styles/global.css";
// using a BaseLayout for
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
// import BlogCard component (used to render post previews)
import BlogCard from "../components/BlogCard.astro";

// Collection in /blog. Gather posts and sort by pubDate (newest first).
const allPosts = (await getCollection("blog")).sort((a, b) => {
  const aDate = a.data?.pubDate ? new Date(a.data.pubDate).valueOf() : 0;
  const bDate = b.data?.pubDate ? new Date(b.data.pubDate).valueOf() : 0;
  return bDate - aDate;
});

// Pick the most recent post as featured (if any), and the rest as cards.
const featured = allPosts.length ? allPosts[0] : null;
const others = allPosts.length > 1 ? allPosts.slice(1) : [];

// --- Metadata ---
// page title
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
  <h2>This is where I will post about my journey learning Astro.</h2>

  <!-- Featured section: show the most recent post in a larger format -->
  {
    featured ? (
      <section class="m-2 p-4 border-2 border-(--accent) rounded-lg">
        <a
          class="flex flex-col md:flex-row gap-4 border-2 border-(--accent) rounded-lg p-4 m-4"
          href={`/posts/${featured.id}/`}
        >
          {featured.data.image && (
            <Image
              width={250}
              height={200}
              src={featured.data.image.src}
              alt={featured.data.image.alt ?? ""}
            />
          )}
          <div class="p-4 m-4 items-start justify-start border-2 border-(--accent) rounded-lg">
            <h3>{featured.data?.title}</h3>
            {featured.data?.pubDate ? (
              <p class="date">
                {new Date(featured.data.pubDate).toLocaleDateString()}
              </p>
            ) : null}
            {featured.data?.description ? (
              <p>{featured.data.description}</p>
            ) : null}
          </div>
        </a>
      </section>
    ) : null
  }

  <!-- Cards section: render remaining posts as compact cards using BlogCard -->
  <section class="cards">
    <ul>
      {others.map((post) => <BlogCard post={post} />)}
    </ul>
  </section>
</BaseLayout>
