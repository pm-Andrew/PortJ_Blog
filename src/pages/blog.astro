---
// Import Collection
import { getCollection } from "astro:content";
// import global CSS
import "../styles/global.css";
// using a BaseLayout for
import BaseLayout from "../layouts/BaseLayout.astro";
// import BlogPost component
import BlogPost from "../components/BlogPost.astro";
// Collection in /blog.
const allPosts = await getCollection("blog");
// --- Metadata ---
// page title
const pageTitle = "Blog";
---

<BaseLayout pageTitle={pageTitle}>
    <h2>This is where I will post about my journey learning Astro.</h2>
    <p>Latest Posts:</p>
    <!-- Linking the blog posts/ content  -->
    <ul>
        <!-- 
        // replacing individual list elements with astro-supported typescript.
            entire list of blog posts is now being generated dynamically using Astro’s built-in TypeScript support, 
            by mapping over the array returned by import.meta.glob().
        -->
        {
            allPosts.map((post) => (
                // This generates input for [...slug].astro
                <BlogPost url={`/posts/${post.id}/`} title={post.data.title} />
            ))
        }
    </ul>
</BaseLayout>
